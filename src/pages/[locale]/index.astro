---
import StudioPage from '../../components/StudioPage.astro';
import { locales, type Locale } from '../../lib/copy';
export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<StudioPage locale={locale} />
