---
import { brand, defaultLocale, home } from '../lib/site';
import { copy, locales } from '../lib/copy';
const locale = defaultLocale;
---
<!doctype html>
<html lang={locale}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex" /><title>404 | {brand}</title></head>
  <body>
    <main><h1>404. {copy[locale].missing[0]}</h1><p><a href={home(locale)}>{copy[locale].missing[1]}</a></p>{locales.filter(lang => lang !== locale).map(lang => <p lang={lang}><a href={home(lang)} hreflang={lang}>{copy[lang].name}</a></p>)}</main>
  </body>
</html>
<style>
  :global(body) { margin: 0; background: #15221b; color: #fff; font: 1rem/1.5 system-ui, sans-serif; }
  main { max-width: 48rem; margin: auto; padding: 4rem 1.5rem; }
  a { color: #ddff9a; }
</style>
