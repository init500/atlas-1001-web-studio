---
import PromoCard from '../../components/PromoCard.astro';
import { locales, type Locale } from '../../lib/copy';
export function getStaticPaths() {
  return locales.filter(locale => locale !== 'ka').map(locale => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<PromoCard locale={locale} />
