---
import { copy, locales, type Locale } from '../lib/copy';
import { base, brand, contacts, home, origin } from '../lib/site';
import Wordmark from './Wordmark.astro';
import PackagePrice from './PackagePrice.astro';
import '../styles/studio.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const url = home(locale);
const navIds = ['services', 'process', 'pricing', 'contact'];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#121b16" />
    <meta property="og:title" content={brand} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={origin + url} />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <link rel="canonical" href={origin + url} />
    {locales.map(lang => <link rel="alternate" hreflang={lang} href={origin + home(lang)} />)}
    <link rel="alternate" hreflang="x-default" href={origin + base} />
    <title>{brand}</title>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="header">
      <div class="wrap header-inner">
        <Wordmark href={url} />
        <nav class="section-links" aria-label={t.navLabel}>{t.nav.map((label, i) => <a href={'#' + navIds[i]}>{label}</a>)}</nav>
        <nav class="languages" aria-label={t.languageLabel}>
          {locales.map(lang => <a href={home(lang)} hreflang={lang} lang={lang} aria-current={locale === lang ? 'page' : undefined} aria-label={copy[lang].name}>{lang.toUpperCase()}</a>)}
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow">{brand}</p>
            <h1>{t.headline[0]} <span>{t.headline[1]}</span></h1>
            <p class="hero-intro">{t.intro}</p>
            <div class="actions">
              <a class="button" href="#services">{t.nav[0]}</a>
              <a class="text-link" href="#pricing">{t.nav[2]}</a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true"><div class="atlas-orb"></div></div>
        </div>
      </section>
      <section class="wrap section" id="services">
        <div class="package-grid">
          <div>
            <h2>{t.includedTitle}</h2>
            <ul class="included-list" role="list">
              {t.included.map(item => <li><span class="included-check" aria-hidden="true">✓</span><span>{item}</span></li>)}
            </ul>
          </div>
          <PackagePrice locale={locale} />
        </div>
      </section>
      <section class="showcase" aria-labelledby="showcase">
        <div class="wrap showcase-grid">
          <div><h2 id="showcase">{t.showcase[0]}</h2><p>{t.showcase[1]}</p></div>
          <figure aria-label={t.specimen[1]}>
            <div class="mock-desktop" aria-hidden="true"><div class="mock-art"></div><div class="mock-copy"><b>{t.specimen[0]}</b></div></div>
            <div class="mock-phone" aria-hidden="true"><div class="mock-art"></div><div class="mock-copy"><b>{t.specimen[0]}</b></div></div>
          </figure>
        </div>
      </section>
      <section class="wrap section process" id="process">
        <div><h2>{t.process}</h2><h3>{t.why[0]}</h3><p>{t.why[1]}</p></div>
        <ol>{t.steps.map(([title, detail]) => <li><h3>{title}</h3><p>{detail}</p></li>)}</ol>
      </section>
      <section class="wrap section contact" id="contact">
        <h2>{t.contact[0]}</h2>
        <p>{t.contact[1]}</p>
        {contacts.length ? <ul>{contacts.map(channel => <li><a href={channel.href}>{channel.label}</a></li>)}</ul> : <p class="contact-status">{t.contact[2]}</p>}
      </section>
    </main>
    <footer class="footer"><div class="wrap"><Wordmark href={url} /><p>© {new Date().getFullYear()} {brand}</p></div></footer>
  </body>
</html>
