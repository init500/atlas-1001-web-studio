---
import { copy, type Locale } from '../lib/copy';
import { studioContactLinks } from '../lib/contact';
import settings from '../config/contact.json';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const links = studioContactLinks(settings);
---
<section class="wrap section contact" id="contact">
  <h2>{t.contact[0]}</h2>
  <p>{t.contact[1]}</p>
  {links.length ? <ul class="contact-links" role="list">{links.map(link => <li>
    <a class:list={[link.kind === 'email' && 'button']} href={link.href} target={link.kind === 'whatsapp' ? '_blank' : undefined} rel={link.kind === 'whatsapp' ? 'noopener noreferrer' : undefined}>
      {t.contactLabels[link.kind]}{link.kind === 'phone' ? ' ' + link.text : ''}
    </a>
    {link.kind === 'email' && <span class="contact-address">{link.text}</span>}
  </li>)}</ul> : <p class="contact-status">{t.contact[2]}</p>}
</section>
