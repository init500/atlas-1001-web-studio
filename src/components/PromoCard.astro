---
import { copy, type Locale } from '../lib/copy';
import { brand, home } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const [title, description, link] = copy[locale].promo;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{brand}</title>
  </head>
  <body>
    <main>
      <p class="brand">{brand}</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <a href={home(locale) + '#services'} target="_blank" rel="noopener noreferrer">{link}</a>
    </main>
    <script is:inline>
      if (parent !== window) parent.postMessage('atlas-1001-promo-ready', '*');
    </script>
  </body>
</html>
<style>
  :global(html) { color-scheme: light; }
  :global(body) { margin: 0; font-family: system-ui, sans-serif; }
  main { background: #15221b; color: #eff5ed; box-sizing: border-box; padding: 1rem; min-height: 100vh; }
  h1, p { margin: 0 0 .4rem; }
  .brand { color: #d9fc8d; font-size: .875rem; font-weight: 700; }
  h1 { font-size: 1.125rem; line-height: 1.3; }
  p { font-size: 1rem; line-height: 1.4; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: #ddff9a; font-weight: 700; text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
